ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:3010
DATABASE_URL=postgresql+psycopg://brain_backend:brain_backend_dev_password@localhost:55432/brain_assistant_backend
SECRET_KEY=replace-this-with-a-random-64-character-production-secret
BACKEND_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=false

# Auth provider: local or keycloak
AUTH_PROVIDER=local
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_INTERNAL_BASE_URL=http://localhost:8080/idp
KEYCLOAK_REALM=brain-assistant
KEYCLOAK_CLIENT_ID=brain-assistant-onboarding
# Optional override. Defaults to KEYCLOAK_BASE_URL/realms/KEYCLOAK_REALM/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=

MAIL_MODE=dev
MAIL_FROM=Brain Assistant <no-reply@brainassistant.local>
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24
INVITATION_EXPIRE_DAYS=7
UPLOAD_STORAGE_PATH=storage/uploads
UPLOAD_MAX_BYTES=26214400
BACKEND_PUBLIC_URL=http://localhost:8010

# External knowledge sources: Google Drive and OneDrive OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
EXTERNAL_SOURCE_SYNC_INTERVAL_HOURS=24

# Embeddings via Ollama (bge-m3, 1024-dim, multilingual)
OLLAMA_BASE_URL=http://10.112.30.10:11434
EMBED_MODEL=bge-m3:latest
# Capable model for entity extraction during ingestion
INGEST_LLM_MODEL=qwen3.5:9b
# Tiny fast model for query-time answer generation
QUERY_LLM_MODEL=qwen3.5:0.8b
LIGHTRAG_WORKING_DIR=./lightrag_storage

# RAG + crawler LLM: OpenAI-compatible Chat Completions endpoint. Used for
# bot replies, entity extraction during ingest, and the website crawler's
# URL classification. Add your key in .env (never commit it).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# Chatwoot AgentBot — local dev fallbacks (ignored once a chatwoot_connections row exists)
# AgentBot outgoing URL must point to this service: http://host.docker.internal:8000/api/v1/webhooks/chatwoot/agent-bot
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=0
CHATWOOT_AGENT_BOT_ID=0
CHATWOOT_AGENT_BOT_TOKEN=
# Dev-only: a Company UUID used by the env-var fallback when no chatwoot_connections
# row matches the incoming inbox. Leave empty in prod (use real connections).
CHATWOOT_FALLBACK_COMPANY_ID=
