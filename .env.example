ENVIRONMENT=development
FRONTEND_BASE_URL=http://localhost:3010
DATABASE_URL=postgresql+psycopg://brain_backend:brain_backend_dev_password@localhost:55432/brain_assistant_backend
SECRET_KEY=replace-this-with-a-random-64-character-production-secret
BACKEND_CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_COOKIE_SECURE=false
MAIL_MODE=dev
MAIL_FROM=Brain Assistant <no-reply@brainassistant.local>
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24
INVITATION_EXPIRE_DAYS=7
UPLOAD_STORAGE_PATH=storage/uploads
UPLOAD_MAX_BYTES=26214400

# Celery / Redis
REDIS_URL=redis://localhost:6379/0

# Chatwoot AgentBot — local dev fallbacks (ignored once a chatwoot_connections row exists)
# AgentBot outgoing URL must point to this service: http://host.docker.internal:8000/api/v1/webhooks/chatwoot/agent-bot
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_ACCOUNT_ID=
CHATWOOT_AGENT_BOT_ID=
CHATWOOT_AGENT_BOT_TOKEN=
